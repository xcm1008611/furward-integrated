FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY demo-service/requirements-lock.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt && useradd --uid 10001 --create-home demo
COPY demo-service/demo_service ./demo_service
COPY shared ./shared
USER demo
EXPOSE 8100
CMD ["python", "-m", "uvicorn", "demo_service.main:app", "--host", "0.0.0.0", "--port", "8100", "--workers", "1", "--ws-max-size", "8192"]
