# run.py 固定监听 0.0.0.0 并读取 PORT；HOST 用于 python -m app.main，uvicorn 命令行参数优先
HOST=0.0.0.0
PORT=8000
# 自动识别错误时手动指定，如 172.20.10.14
LAN_HOST=
# mock 可直接演示；bridge 留给批次5
ROBOT_BACKEND=mock
# 模拟耗时倍率，测试使用 0.01
MOCK_TIME_SCALE=1.0
# 故障注入，英文逗号分隔，例如 move,mimic
MOCK_FAIL=
# 初始电量百分比
MOCK_BATTERY_START=90
# 线速度，允许 0.2–0.4 米/秒
LINEAR_SPEED=0.3
# 角速度，弧度/秒
ANGULAR_SPEED=0.5
# 单段距离（米）和单次转角（度）上限，超限拒绝
MAX_MOVE_M=3.0
MAX_TURN_DEG=180
# 真机标定系数预留；Mock 按指令距离/速度计算耗时
CALIB_LINEAR_SCALE=1.0
CALIB_ANGULAR_SCALE=1.0
# 命令兜底超时（秒），实际取此值与估算耗时两倍中的较大值
CMD_DEADLINE_S=20
# 机器人状态推送周期（秒）
STATE_INTERVAL_S=1.0
# 每个订阅者的事件队列容量，满时丢弃最旧事件
EVENT_QUEUE_SIZE=128

# 高德 Web 服务 Key，可留空；无 Key 时仅能匹配离线缓存
AMAP_KEY=
AMAP_BASE_URL=https://restapi.amap.com
AMAP_TIMEOUT_S=5
OUTDOOR_CITY=上海
# GCJ-02，经度,纬度；现场改为演示起点
OUTDOOR_DEFAULT_ORIGIN=
# 室外步骤到达半径（米）
NAV_ARRIVE_RADIUS_M=15
# 相对路径以 backend 目录为基准
INDOOR_MAP_PATH=data/indoor_map.json
DEMO_ROUTES_DIR=data/demo_routes
# 手机页离线演示城市底图（由 scripts/export_demo_city.py 从 Blender 场景导出）
DEMO_CITY_PATH=data/demo_city.json
# 位姿推送周期、命令之间稳定等待（秒）；Mock 稳定等待按倍率缩短
NAV_PROGRESS_INTERVAL_S=0.5
NAV_SETTLE_S=0.5
# 规划忽略小转角；恢复时忽略微小剩余距离/角度
NAV_TURN_THRESHOLD_DEG=5
NAV_RESUME_MIN_MOVE_M=0.05
NAV_RESUME_MIN_TURN_DEG=3

# DeepSeek 可选增强；无 Key 时自动走关键词规则
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型名以 DeepSeek 官方文档为准，拿到 Key 后先用 scripts/check_llm.py 验证
DEEPSEEK_MODEL=deepseek-flash
LLM_ENABLED=true
# 工具对话与看图超时（秒）
LLM_TIMEOUT_S=5
VISION_TIMEOUT_S=8
# 保存最近对话轮数，0 表示不保留
ASSISTANT_HISTORY_TURNS=5

# 来源 none/mock/video/rtsp；相对文件路径以 backend 为基准
OBSTACLE_SOURCE=mock
# 示例 rtsp://<机器人IP>:2554/live_head_stereo_left
RTSP_URL=
VIDEO_PATH=
# 四足形态画面朝向要现场确认，可选 0/90/180/270
FRAME_ROTATE=0
# 模型不存在则不加载
DETECTOR_MODEL_PATH=models/yolov8n.onnx
DETECTOR_CONF=0.4
DETECTOR_INPUT_SIZE=640
# box 不属于 COCO 80 类，仅 Mock 支持
OBSTACLE_CLASSES=person,chair,bench,suitcase,backpack,handbag,bicycle,potted plant,dining table,couch,dog,bottle,box
# 通行梯形归一化坐标，底边 y=1
ZONE_TOP_Y=0.55
ZONE_TOP_LEFT=0.35
ZONE_TOP_RIGHT=0.65
ZONE_BOTTOM_LEFT=0.15
ZONE_BOTTOM_RIGHT=0.85
# 框高比例阈值 A/B
STOP_HEIGHT_RATIO=0.35
CAUTION_HEIGHT_RATIO=0.20
# 连续停止帧数、连续清除秒数
STOP_CONFIRM_FRAMES=2
CLEAR_HOLD_S=1.5
OBSTACLE_FPS=10
OBSTACLE_AUTO_RESUME=false
STREAM_FPS=5
# 新帧健康时限、重连间隔（秒），RTSP 打开/读取超时（毫秒）
CAMERA_HEALTH_S=2
CAMERA_RECONNECT_S=2
CAMERA_TIMEOUT_MS=1000

# JS API 的 Key 与 Web 服务的 Key 是两种不同类型的 Key。
AMAP_JS_KEY=
# 安全密钥会下发给局域网内的页面。这是演示用的折中做法，不要用于公网部署。
AMAP_SECURITY_CODE=

# 桥接鉴权；空值表示不校验
BRIDGE_TOKEN=
# 桥接心跳间隔与失联阈值（秒）
BRIDGE_PING_INTERVAL_S=1.0
BRIDGE_STALE_S=3.0
